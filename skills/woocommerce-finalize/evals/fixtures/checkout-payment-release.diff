+++ b/tests/CheckoutGatewayTest.php
@@ -0,0 +1,8 @@
+<?php
+final class CheckoutGatewayTest extends WP_UnitTestCase {
+    public function test_missing_order_returns_404(): void {
+        $response = FixtureCommerce\\CheckoutGateway::confirm_checkout(array('order_id' => 999));
+        $this->assertWPError($response);
+        $this->assertSame(404, $response->get_error_data()['status']);
+    }
+}
